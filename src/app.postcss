@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root, html.light {
    /* Surface Colors (Light Mode) */
    --color-surface-50: 255 255 255;
    --color-surface-100: 248 250 252;
    --color-surface-200: 241 245 249;
    --color-surface-700: 203 213 225;
    --color-surface-800: 241 245 249;
    --color-surface-900: 255 255 255;
    --color-surface-950: 248 250 252;

    /* Slate Text & Borders (Light Mode - Deep Sharp Contrast) */
    --color-slate-50: 15 23 42;
    --color-slate-100: 15 23 42;      /* Deep sharp black-slate #0f172a */
    --color-slate-200: 15 23 42;      /* #0f172a */
    --color-slate-300: 30 41 59;      /* #1e293b */
    --color-slate-400: 51 65 85;      /* #334155 (Crisp, highly readable) */
    --color-slate-500: 71 85 105;     /* #475569 */
    --color-slate-600: 100 116 139;   /* #64748b */
    --color-slate-700: 203 213 225;   /* #cbd5e1 */
    --color-slate-800: 226 232 240;   /* #e2e8f0 */
    --color-slate-900: 241 245 249;   /* #f1f5f9 */
    --color-slate-950: 248 250 252;   /* #f8fafc */
  }

  html.dark {
    /* Surface Colors (Dark Mode) */
    --color-surface-50: 248 250 252;
    --color-surface-100: 241 245 249;
    --color-surface-200: 226 232 240;
    --color-surface-700: 51 65 85;
    --color-surface-800: 30 41 59;
    --color-surface-900: 15 23 42;
    --color-surface-950: 2 6 23;

    /* Slate Text & Borders (Dark Mode) */
    --color-slate-50: 248 250 252;
    --color-slate-100: 241 245 249;
    --color-slate-200: 226 232 240;
    --color-slate-300: 203 213 225;
    --color-slate-400: 148 163 184;
    --color-slate-500: 100 116 139;
    --color-slate-600: 71 85 105;
    --color-slate-700: 51 65 85;
    --color-slate-800: 30 41 59;
    --color-slate-900: 15 23 42;
    --color-slate-950: 2 6 23;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.2);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.4);
  }
}

.glass-panel {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
